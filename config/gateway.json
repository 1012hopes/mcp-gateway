{
  "gateway": {
    "name": "mcp-gateway",
    "trace_dir": "traces/runs",
    "model_id": "unlabeled-agent",
    "schema_manifest": "config/schema-manifest.json",
    "gating": {
      "enabled": true,
      "k": 5,
      "m": 10,
      "index": "enriched"
    }
  },
  "upstreams": [
    {
      "name": "sqlite",
      "command": "{python}",
      "args": ["-m", "mcp_servers.sqlite_server", "--db", "var/demo.sqlite3"],
      "cwd": "{root}",
      "call_timeout_s": 20
    },
    {
      "name": "dirty",
      "command": "{python}",
      "args": ["-m", "mcp_servers.dirty_schema_server"],
      "cwd": "{root}",
      "call_timeout_s": 20
    },
    {
      "name": "wiki",
      "command": "{python}",
      "args": ["-m", "mcp_servers.wiki_server"],
      "cwd": "{root}",
      "call_timeout_s": 20
    },
    {
      "name": "gh",
      "command": "{python}",
      "args": ["-m", "mcp_servers.gh_server"],
      "cwd": "{root}",
      "call_timeout_s": 20
    }
  ]
}
