{
  "id": "t03",
  "goal": "Which releases were breaking changes, and when was each published?",
  "required_evidence": ["sql.schema", "sql.rows.releases"],
  "optimal_steps": 2,
  "optimal_path": "sqlite.list_tables -> sqlite.query (releases where breaking = 1)",
  "plan": [
    { "tool": "sqlite.list_tables", "args": {} },
