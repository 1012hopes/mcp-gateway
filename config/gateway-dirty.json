{
  "gateway": {
    "name": "mcp-gateway-dirty",
    "trace_dir": "traces/runs",
    "model_id": "compat-fixture",
    "schema_manifest": "config/schema-manifest-compat.json"
  },
  "upstreams": [
    {
      "name": "sqlite",
      "command": "{python}",
      "args": ["-m", "mcp_servers.sqlite_server", "--db", "var/demo.sqlite3"],
      "cwd": "{root}",
      "call_timeout_s": 20
    },
    {
      "name": "dirty",
      "command": "{python}",
      "args": ["-m", "mcp_servers.dirty_schema_server"],
      "cwd": "{root}",
      "call_timeout_s": 20
    },
    {
      "name": "weird",
      "command": "{python}",
      "args": ["-m", "mcp_servers.weird_capability_server"],
      "cwd": "{root}",
      "call_timeout_s": 20
    },
    {
      "name": "flake",
      "command": "{python}",
      "args": ["-m", "mcp_servers.slow_flaky_server"],
      "cwd": "{root}",
      "call_timeout_s": 0.5
    }
  ]
}
